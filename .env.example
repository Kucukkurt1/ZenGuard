# --- PostgreSQL (compose + uygulama) ---
POSTGRES_USER=zenguard
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=zenguard

# API: SQLAlchemy async sürücüsü
DATABASE_URL=postgresql+asyncpg://zenguard:change_me_postgres@postgres:5432/zenguard

# Celery worker: senkron psycopg
DATABASE_URL_SYNC=postgresql+psycopg://zenguard:change_me_postgres@postgres:5432/zenguard

# --- Redis (parola REDIS_URL ile aynı kaynaktan) ---
REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@redis:6379/0

# Celery sonuç önbelleği TTL (asıl sonuç PostgreSQL'de)
CELERY_RESULT_TTL_SECONDS=3600

# --- ClamAV ---
# Sandbox / worker içinde Unix soket (clamav-run volume)
CLAMAV_SOCKET=/run/clamav/clamd.sock
# API sağlık kontrolü için iç ağ TCP
CLAMAV_TCP_ADDR=clamav:3310

# --- Sandbox modu: docker (üretim) | inprocess (yalnızca birim testleri) ---
ZENG_SANDBOX_MODE=docker

# --- ZenGuard limitleri (ARCHITECTURE.md bölüm 10) ---
ZENG_MAX_UPLOAD_BYTES=52428800
ZENG_MAX_UNCOMPRESSED_BYTES=104857600
ZENG_MAX_ARCHIVE_DEPTH=3
ZENG_MAX_ARCHIVE_FILES=200
ZENG_ZIP_BOMB_RATIO=1000
ZENG_SANDBOX_TIMEOUT_SECONDS=120

# Karantina kökü (volume içi yol)
ZENG_QUARANTINE_DIR=/var/lib/zenguard/quarantine

# CORS (virgülle ayrılmış kökenler)
ZENG_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Frontend (Faz 5) ---
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
